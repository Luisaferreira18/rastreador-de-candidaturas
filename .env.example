# Copie este arquivo para .env.local e preencha os valores.
# Onde encontrar cada chave: veja a seção "Configurar o Supabase" do README.

# --- Supabase (obrigatório) -------------------------------------------------
# Painel do Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Painel do Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase, chave secreta (conta demo, WhatsApp e busca diária de vagas) --
# Painel do Supabase > Project Settings > API Keys > Secret keys (sb_secret_...)
# NUNCA coloque NEXT_PUBLIC_ na frente desta: ela ignora o RLS e não pode ir para o navegador.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Endereço do site (opcional) --------------------------------------------
# Usado nos links dos e-mails e no retorno do Google. Se ficar vazio, o app usa o
# endereço da própria requisição. Em produção: https://seu-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Login com Google (opcional) --------------------------------------------
# Deixe "true" só depois de ativar o provedor Google no Supabase (veja o README).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Conta de demonstração (opcional) ---------------------------------------
# Com estes dois preenchidos, a tela de login mostra "Explorar a demonstração".
# Crie a conta e os dados com: npm run seed:demo
DEMO_EMAIL=demo@rastreador.app
DEMO_PASSWORD=troque-esta-senha-123

# Protege as rotas dos crons diários: restaurar a conta demo (/api/cron/reset-demo),
# buscar vagas (/api/cron/vagas) e concursos (/api/cron/concursos) para todos os perfis.
# Gere um valor aleatório, por exemplo: openssl rand -hex 32
CRON_SECRET=

# --- Assistente no WhatsApp (opcional, API oficial da Meta) -----------------
# Passo a passo na seção "Assistente no WhatsApp" do README.
# Sem WHATSAPP_TOKEN/WHATSAPP_PHONE_NUMBER_ID, o assistente fica em modo de teste (só log).
# Também precisa da SUPABASE_SECRET_KEY acima.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Número do assistente, só dígitos com DDI e DDD (ex.: 5511999990000).
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=

# --- Caça-concursos: Diário Oficial da União pelo INLABS (opcional) ----------
# Cadastro gratuito em https://inlabs.in.gov.br (a conta é sua: o app só baixa o
# arquivo XML da Seção 3 de cada dia). Sem estes dois, a busca usa o arquivo
# público do mês da página de Dados Abertos da Imprensa Nacional (mais pesado).
INLABS_EMAIL=
INLABS_PASSWORD=
